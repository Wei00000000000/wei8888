FROM nginx:1.31-alpine
COPY index.html app.html login.html scanner-api-trace.html api-config.js sw.js manifest.webmanifest icon.svg icon-192.png icon-512.png brand-hero.png /usr/share/nginx/html/
COPY data/ /usr/share/nginx/html/data/
EXPOSE 8080
RUN sed -i 's/listen       80;/listen 8080;/' /etc/nginx/conf.d/default.conf
