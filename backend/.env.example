APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./wei_strategy.db
JWT_SECRET=replace-with-at-least-32-random-characters
APP_PASSWORD_HASH=replace-with-argon2-password-hash
ADMIN_TOKEN=replace-with-a-separate-random-admin-token
CORS_ORIGINS=https://wei00000000000.github.io
ALLOWED_HOSTS=your-api-domain.zeabur.app
COOKIE_SECURE=true
COOKIE_SAMESITE=none
ACCESS_TOKEN_MINUTES=480
COINGLASS_API_KEY=
MARKET_DATA_PROVIDER=mixed
MIN_QUOTE_VOLUME_USDT=5000000
AUTO_CREATE_SCHEMA=true
RUN_SCANNER=true
SCANNER_TIMEOUT_SECONDS=720
